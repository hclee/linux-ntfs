+/**
+ * mkntfs_write_mft_records -
+ */
+static BOOL mkntfs_write_mft_records(s64 pos, int count, u8 *buf)
+{
+	int i;
+	int full_count;
+	int tail_count;
+	int j;
+	int records_per_write;
+	s64 lw;
+	u8 *tail_buf;
+
+	if (count < 0 || !buf) {
+		ntfs_log_error("Invalid MFT write parameters.\n");
+		return FALSE;
+	}
+	if (g_vol->mft_record_size < (u32)opts.sector_size)
+		records_per_write = opts.sector_size / g_vol->mft_record_size;
+	else
+		records_per_write = 1;
+	if (!records_per_write || pos % opts.sector_size) {
+		ntfs_log_error("MFT records are not sector aligned.\n");
+		return FALSE;
+	}
+	full_count = count - count % records_per_write;
+	for (i = 0; i < full_count; i += records_per_write) {
+		if (!opts.no_action) {
+			lw = ntfs_mst_pwrite(g_vol->dev, pos, records_per_write,
+					g_vol->mft_record_size,
+					buf + i * g_vol->mft_record_size);
+			if (lw != records_per_write) {
+				ntfs_log_error("ntfs_mst_pwrite: %s\n",
+						lw == -1 ? strerror(errno) :
+						"unknown error");
+				return FALSE;
+			}
+		}
+		pos += (s64)records_per_write * g_vol->mft_record_size;
+	}
+	if (full_count == count || opts.no_action)
+		return TRUE;
+
+	/* Complete the final physical sector without extending the MFT size. */
+	tail_count = count - full_count;
+	tail_buf = ntfs_calloc(records_per_write * g_vol->mft_record_size);
+	if (!tail_buf) {
+		ntfs_log_perror("Could not allocate the MFT sector buffer");
+		return FALSE;
+	}
+	memcpy(tail_buf, buf + full_count * g_vol->mft_record_size,
+			tail_count * g_vol->mft_record_size);
+	for (j = tail_count; j < records_per_write; j++)
+		if (ntfs_mft_record_layout(g_vol, 0,
+					(MFT_RECORD *)(tail_buf +
+					j * g_vol->mft_record_size))) {
+			ntfs_log_error("Failed to layout MFT padding record.\n");
+			free(tail_buf);
+			return FALSE;
+		}
+	lw = ntfs_mst_pwrite(g_vol->dev, pos, records_per_write,
+			g_vol->mft_record_size, tail_buf);
+	free(tail_buf);
+	if (lw != records_per_write) {
+		ntfs_log_error("ntfs_mst_pwrite: %s\n", lw == -1 ?
+				strerror(errno) : "unknown error");
+		return FALSE;
+	}
+	return TRUE;
+}
