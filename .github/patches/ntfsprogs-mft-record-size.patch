+/**
+ * mkntfs_validate_mft_record_size -
+ */
+static BOOL mkntfs_validate_mft_record_size(const ntfs_volume *vol,
+		long page_size)
+{
+	unsigned long mft_size;
+
+	if (!opts.mft_record_size_set)
+		return TRUE;
+	if (opts.mft_record_size <= 0) {
+		ntfs_log_error("The MFT record size must be positive.\n");
+		return FALSE;
+	}
+	mft_size = (unsigned long)opts.mft_record_size;
+	if (mft_size < NTFS_BLOCK_SIZE ||
+			(mft_size & (mft_size - 1))) {
+		ntfs_log_error("MFT record size must be power of two, at least %u.\n",
+			NTFS_BLOCK_SIZE);
+		return FALSE;
+	}
+	if (mft_size > (unsigned long)page_size) {
+		ntfs_log_error("MFT record size exceeds page size (%li bytes).\n",
+			page_size);
+		return FALSE;
+	}
+	if (mft_size < (unsigned long)opts.sector_size) {
+		if (opts.sector_size % (long)mft_size) {
+			ntfs_log_error("MFT record size must divide sector size.\n");
+			return FALSE;
+		}
+	} else if (mft_size % (unsigned long)opts.sector_size) {
+		ntfs_log_error("MFT record size must be a sector multiple.\n");
+		return FALSE;
+	}
+	if (mft_size < vol->cluster_size) {
+		if (vol->cluster_size % mft_size) {
+			ntfs_log_error("MFT record size must divide cluster size.\n");
+			return FALSE;
+		}
+	} else if (mft_size % vol->cluster_size) {
+		ntfs_log_error("MFT record size must be a cluster multiple.\n");
+		return FALSE;
+	}
+	return TRUE;
+}
